ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Comma-separated, only needed if the browser calls the API directly (not via the Vite proxy)
CORS_ORIGINS=
REVIEWER=stub
# Pause between review stages so progress is visible in the UI (0 to 5 seconds, stub only)
STUB_STEP_DELAY_SECONDS=0

# ---- AI model (used when REVIEWER=llm) ----
# Any server with an OpenAI-compatible chat API. For Ollama: install it, run
#   ollama pull qwen2.5-coder:7b
# and start it with a bigger context window: OLLAMA_CONTEXT_LENGTH=16384 ollama serve
# REVIEWER=llm
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:latest qwen2.5-coder:7b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=300
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=4096
# Model calls running at once; keep 1 for a single local model.
LLM_MAX_CONCURRENCY=1
# Longest snippet accepted while REVIEWER=llm (about 500 lines).
LLM_MAX_CODE_CHARS=20000
