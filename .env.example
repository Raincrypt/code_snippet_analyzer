# Settings for docker compose. Copy to .env (not committed) and edit.

# "stub" = placeholder reviewer, "llm" = the AI model (also start with: --profile model)
REVIEWER=stub
LLM_MODEL=qwen2.5-coder:7b

# Where the website is reachable. 127.0.0.1 = this computer only.
WEB_PORT=8080
WEB_BIND=127.0.0.1
